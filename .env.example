# WhatsApp Bot Configuration
NODE_ENV=development
BOT_NAME=Bot WhatsApp Pro
BOT_PREFIX=.

# Owner WhatsApp Number (with country code, no symbols)
OWNER_NUMBER=5585988888888

# API Keys (Optional)
RANDOM_ORG_API_KEY=your_api_key_here
NINEREST_API_KEY=your_api_key_here

# Database
DB_TYPE=json

# Logging
LOG_LEVEL=info
